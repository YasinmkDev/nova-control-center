<UserControl x:Class="NovaControlCenter.Controls.DonutChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Canvas x:Name="DonutCanvas" Width="220" Height="220" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="CenterValue" Text="100%" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Total load" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
