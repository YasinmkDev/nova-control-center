<!-- DesignTokens.xaml — single source of truth. All pages use these, never hard-coded colours. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colour tokens: Nova palette -->
    <Color x:Key="NovaAccent">#6C5CE7</Color>
    <Color x:Key="NovaAccent2">#00D2FF</Color>
    <Color x:Key="NovaSuccess">#00E676</Color>
    <Color x:Key="NovaWarning">#FFB020</Color>
    <Color x:Key="NovaDanger">#FF5470</Color>
    <SolidColorBrush x:Key="NovaAccentBrush" Color="{StaticResource NovaAccent}" />
    <SolidColorBrush x:Key="NovaAccent2Brush" Color="{StaticResource NovaAccent2}" />

    <!-- Spacing scale: 4 / 8 / 12 / 16 / 24 / 32 -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>

    <!-- Typography scale -->
    <x:Double x:Key="TextCaption">11</x:Double>
    <x:Double x:Key="TextBody">14</x:Double>
    <x:Double x:Key="TextTitle">20</x:Double>
    <x:Double x:Key="TextDisplay">28</x:Double>

    <!-- Corner radius / elevation -->
    <CornerRadius x:Key="RadiusS">8</CornerRadius>
    <CornerRadius x:Key="RadiusM">12</CornerRadius>
    <CornerRadius x:Key="RadiusL">16</CornerRadius>
    <CornerRadius x:Key="RadiusXL">20</CornerRadius>

    <!-- Card style: acrylic + lift on hover (Composition-driven, GPU) -->
    <Style x:Key="NovaCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusL}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Primary button: scale press 0.97 via VisualState — see MainWindow resources for the full template -->
    <Style x:Key="NovaPrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource NovaAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!-- Reusable entrance: fade + translateY. Applied in code-behind with staggered delays. -->
    <Storyboard x:Key="EntranceStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45" />
    </Storyboard>
</ResourceDictionary>
