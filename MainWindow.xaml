<Window
    x:Class="NovaControlCenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Nova Control Center">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. CUSTOM TITLE BAR — drag area is the whole bar except buttons. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Logo + title (also drag region) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource NovaAccentBrush}">
                    <TextBlock Text="◆" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="NOVA" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Control Center" FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Search in title bar -->
            <AutoSuggestBox x:Name="TitleSearch" Grid.Column="1" Width="320" Height="32"
                PlaceholderText="Search servers, pages…" QueryIcon="Find"
                VerticalAlignment="Center" HorizontalAlignment="Center" />
            <!-- Window controls: animated hover via PointerOver VisualState in code-behind styles -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="MinButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="46" Background="Transparent" BorderThickness="0" Click="MinButton_Click" />
                <Button x:Name="MaxButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="46" Background="Transparent" BorderThickness="0" Click="MaxButton_Click" />
                <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="46" Background="Transparent" BorderThickness="0" Click="CloseButton_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 2. COLLAPSIBLE SIDEBAR — width animated in code-behind with Composition (GPU, 60fps) -->
                <ColumnDefinition x:Name="SidebarColumn" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Acrylic + sliding active indicator -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="CollapseButton" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                        HorizontalAlignment="Left" Margin="12,12,0,0" Background="Transparent" BorderThickness="0" Click="CollapseButton_Click" />
                    <!-- Active indicator: a 3px accent bar that slides (TranslateY animated) -->
                    <Border x:Name="ActiveIndicator" Width="3" Height="44" CornerRadius="2"
                        Background="{StaticResource NovaAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,64,0,0" />
                    <ListView x:Name="NavList" Grid.Row="1" Margin="8,8,8,0" SelectionMode="Single"
                        SelectionChanged="NavList_SelectionChanged" IsTabStop="True">
                        <ListViewItem Tag="Dashboard" Content="Dashboard" />
                        <ListViewItem Tag="Data" Content="Data" />
                        <ListViewItem Tag="Visual" Content="3D / Visual" />
                        <ListViewItem Tag="Settings" Content="Settings" />
                    </ListView>
                    <StackPanel Grid.Row="2" Margin="16" Spacing="4">
                        <TextBlock x:Name="SidebarFooterTitle" Text="Nova v1.0" FontSize="12" Opacity="0.7" />
                        <TextBlock x:Name="SidebarFooterSub" Text="WinUI 3 • .NET 8" FontSize="11" Opacity="0.45" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content + Toasts -->
            <Grid Grid.Column="1">
                <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
                <!-- Toast host: top-right, stacked, slide in/out -->
                <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,16,0" Spacing="8" Width="340" />
                <!-- Drag-drop demo list lives on Dashboard; modal is opened via ContentDialog -->
            </Grid>
        </Grid>
    </Grid>
</Window>
