<UserControl x:Class="NovaControlCenter.Controls.StatCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Hover lift/glow is Composition in code-behind: Scale 1.02 + shadow on PointerEntered -->
    <Border x:Name="Card" Style="{StaticResource NovaCardStyle}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="LabelText" FontSize="12" Opacity="0.65" />
            <TextBlock x:Name="ValueText" Grid.Row="1" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <TextBlock x:Name="DeltaText" FontSize="12" Foreground="{StaticResource NovaAccent2Brush}" FontWeight="SemiBold" />
                <TextBlock x:Name="HintText" FontSize="12" Opacity="0.55" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
