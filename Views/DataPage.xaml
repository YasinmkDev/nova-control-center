<Page x:Class="NovaControlCenter.Views.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Servers — 60 rows" FontSize="28" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="SearchBox" Width="320" PlaceholderText="Search name, region, status…" TextChanged="SearchBox_TextChanged" />
            <Button Content="+ Add row" Click="AddRow_Click" Style="{StaticResource NovaPrimaryButton}" />
            <Button Content="Delete selected" Click="DeleteRow_Click" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Opacity="0.6" />
        </StackPanel>
        <!-- Skeleton shimmer: shown for 900ms on load, then DataGrid fades in -->
        <Grid x:Name="Skeleton" Grid.Row="2">
            <StackPanel Spacing="8">
                <Border Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Opacity="0.7" />
                <Border Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Opacity="0.5" />
                <Border Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Opacity="0.35" />
                <Border Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Opacity="0.25" />
            </StackPanel>
        </Grid>
        <controls:DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
            Sorting="Grid_Sorting" Visibility="Collapsed" SelectionMode="Extended">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <controls:DataGridTextColumn Header="Region" Binding="{Binding Region}" />
                <controls:DataGridTextColumn Header="CPU %" Binding="{Binding Cpu}" />
                <controls:DataGridTextColumn Header="Memory %" Binding="{Binding Memory}" />
                <controls:DataGridTextColumn Header="Uptime (d)" Binding="{Binding UptimeDays}" />
                <controls:DataGridTextColumn Header="Status" Binding="{Binding Status}" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </Grid>
</Page>
