<UserControl x:Class="NovaControlCenter.Controls.LineChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Drawn in code-behind on a Canvas: polyline + gradient fill + dots. DrawProgress 0..1 reveals it on load. -->
        <Canvas x:Name="ChartCanvas" />
        <TextBlock x:Name="EmptyText" Text="Loading…" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
