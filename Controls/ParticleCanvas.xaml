<UserControl x:Class="NovaControlCenter.Controls.ParticleCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <!-- Win2D CanvasControl: GPU-accelerated 2D, 120 particles + gradient mesh background. Pointer = repulsor. -->
    <canvas:CanvasControl x:Name="Canvas" Draw="Canvas_Draw" CreateResources="Canvas_CreateResources" PointerMoved="Canvas_PointerMoved" PointerExited="Canvas_PointerExited" ClearColor="Transparent" />
</UserControl>
